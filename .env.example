# Copy to backend/.env for local development
DATABASE_URL=postgresql://halal:halal@localhost:5433/halal_basket?schema=public
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
SEED_PASSWORD=HalalBasket123!
PORT=3000
NODE_ENV=development
FEATURE_REALTIME_DELIVERY=false
FEATURE_MULTI_SHOP=false
REALTIME_MAX_RISK_SCORE=50
# Minutes until estimatedDeliveryAt for realtime_delivery (min 15, default 60)
REALTIME_ETA_MINUTES=60
# mock | stripe  (use stripe + sk_test_/pk_test_ for Staging or local Stripe CLI)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Customer app origin for Stripe Checkout success/cancel URLs (required when PAYMENT_PROVIDER=stripe)
FRONTEND_URL=http://localhost:5173
# Public base URL for uploaded assets (/uploads/…). Defaults to http://localhost:3000.
# For WhatsApp catalog sync, Meta must fetch images — use your HTTPS tunnel, e.g.:
# PUBLIC_API_URL=https://xxxx.trycloudflare.com
PUBLIC_API_URL=http://localhost:3000
# Must list every browser origin that calls the API (customer + shop + driver + admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# WhatsApp Phase A (optional — empty = console stub in Nest logs)
# Meta Cloud API: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=           # Meta webhook verify token (GET /whatsapp/webhook)
WHATSAPP_CATALOG_ID=             # Meta Commerce catalog ID (Phase D sync / catalog messages)
WHATSAPP_TEMPLATE_ORDER_PLACED=
WHATSAPP_TEMPLATE_PAYMENT_RECEIVED=
WHATSAPP_TEMPLATE_FULFILLMENT=
# Pay / track links in WhatsApp messages (defaults to FRONTEND_URL)
CUSTOMER_APP_URL=http://localhost:5173
