generator client {
  provider = "prisma-client-js"
}

/// Seed/scripts client (kept outside gitignore so the IDE can resolve model delegates).
generator clientTypes {
  provider = "prisma-client-js"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  shop
  driver
  admin
  super_admin
}

enum StockStatusSource {
  shop
  system
  import
}

enum FulfillmentMode {
  pickup
  scheduled_delivery
  realtime_delivery
}

enum OrderStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled
}

enum FulfillmentStatus {
  pending
  preparing
  ready
  out_for_delivery
  delivered
  failed_attempt
  cancelled
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum OrderEventType {
  status_change
  refund
  complaint
  note
  driver_feedback_linked
}

enum Weekday {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}

enum ShopKind {
  shop
  warehouse
}

enum StockHoldStatus {
  active
  consumed
  released
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  phone             String?   @unique
  passwordHash      String    @map("password_hash")
  role              UserRole
  /// Dynamic staff role (admin portal). Portal type still uses `role` enum.
  staffRoleId       String?   @map("staff_role_id")
  avatarUrl         String?   @map("avatar_url")
  isActive          Boolean   @default(true) @map("is_active")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  createdAt         DateTime  @default(now()) @map("created_at")

  staffRole Role?          @relation(fields: [staffRoleId], references: [id], onDelete: SetNull)
  customer  Customer?
  shopUsers ShopUser[]
  driver    Driver?
  events    OrderEvent[] @relation("EventActor")

  @@index([staffRoleId])
  @@map("users")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  name        String
  description String?
  groupName   String @map("group_name")

  rolePermissions RolePermission[]

  @@index([groupName])
  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Customer {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  name             String
  addressList      Json      @default("[]") @map("address_list")
  riskScore        Int       @default(0) @map("risk_score")
  isBlocked        Boolean   @default(false) @map("is_blocked")
  whatsappOptIn    Boolean   @default(false) @map("whatsapp_opt_in")
  whatsappOptInAt  DateTime? @map("whatsapp_opt_in_at")

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders    Order[]
  feedback  DriverFeedback[]
  stockHolds StockHold[]
  favourites CustomerFavourite[]
  whatsappThreads WhatsappThread[]

  @@map("customers")
}

model ShopUser {
  id     String @id @default(uuid())
  userId String @map("user_id")
  shopId String @map("shop_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@map("shop_users")
}

model Category {
  id   String @id @default(uuid())
  name String
  slug String @unique

  products Product[]

  @@map("categories")
}

model Product {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  categoryId     String?  @map("category_id")
  description    String?
  imageUrl       String?  @map("image_url")
  tags           Json     @default("[]")
  isActive       Boolean  @default(true) @map("is_active")
  barcode        String   @unique
  qrCode         String   @map("qr_code")
  qrCodeImageUrl String?  @map("qr_code_image_url")
  sku            String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category     Category?     @relation(fields: [categoryId], references: [id])
  shopProducts ShopProduct[]
  orderItems   OrderItem[]
  holdLines    StockHoldLine[]
  favourites   CustomerFavourite[]

  @@map("products")
}

model CustomerFavourite {
  id         String   @id @default(uuid())
  customerId String   @map("customer_id")
  productId  String   @map("product_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@index([customerId, createdAt])
  @@map("customer_favourites")
}

model Shop {
  id              String   @id @default(uuid())
  name            String
  kind            ShopKind @default(shop)
  parentCompanyId String?  @map("parent_company_id")
  address         String?
  phone           String?
  email           String?
  openingHours    Json     @default("{}") @map("opening_hours")
  deliveryZones   Json     @default("[]") @map("delivery_zones")
  lat             Float?
  lng             Float?
  isActive        Boolean  @default(true) @map("is_active")

  shopUsers        ShopUser[]
  shopProducts     ShopProduct[]
  fulfillments     OrderFulfillment[]
  preferredOrders  Order[]            @relation("PreferredShop")

  @@index([kind, isActive])
  @@map("shops")
}

model ShopProduct {
  id                String            @id @default(uuid())
  shopId            String            @map("shop_id")
  productId         String            @map("product_id")
  price             Decimal           @db.Decimal(10, 2)
  discountPrice     Decimal?          @map("discount_price") @db.Decimal(10, 2)
  isInStock         Boolean           @default(true) @map("is_in_stock")
  /// Sellable units on hand. Soft holds reserve against this without decrementing until order.
  stockQuantity     Int               @default(0) @map("stock_quantity")
  stockStatusSource StockStatusSource @default(shop) @map("stock_status_source")
  lastStockUpdateAt DateTime?         @map("last_stock_update_at")
  isVisible         Boolean           @default(true) @map("is_visible")

  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  holdLines  StockHoldLine[]

  @@unique([shopId, productId])
  @@index([shopId, isInStock, isVisible])
  @@map("shop_products")
}

model StockHold {
  id         String          @id @default(uuid())
  customerId String          @map("customer_id")
  status     StockHoldStatus @default(active)
  expiresAt  DateTime        @map("expires_at")
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  lines    StockHoldLine[]

  @@index([customerId, status])
  @@index([expiresAt])
  @@map("stock_holds")
}

model StockHoldLine {
  id            String @id @default(uuid())
  holdId        String @map("hold_id")
  shopProductId String @map("shop_product_id")
  productId     String @map("product_id")
  quantity      Int

  hold        StockHold   @relation(fields: [holdId], references: [id], onDelete: Cascade)
  shopProduct ShopProduct @relation(fields: [shopProductId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])

  @@index([shopProductId])
  @@index([holdId])
  @@map("stock_hold_lines")
}

model Order {
  id                 String          @id @default(uuid())
  customerId         String          @map("customer_id")
  fulfillmentMode    FulfillmentMode @map("fulfillment_mode")
  status             OrderStatus     @default(pending)
  /// Line items total before discounts and HB delivery fee.
  subtotalAmount     Decimal         @map("subtotal_amount") @db.Decimal(12, 2)
  /// Coupon / promo discount applied to subtotal at order time.
  discountAmount     Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  /// Platform delivery fee (0 for pickup). Set from PlatformSetting at order time.
  deliveryFeeAmount  Decimal         @default(0) @map("delivery_fee_amount") @db.Decimal(12, 2)
  /// Grand total = subtotalAmount - discountAmount + deliveryFeeAmount.
  totalAmount        Decimal         @map("total_amount") @db.Decimal(12, 2)
  /// Applied coupon code when discountAmount > 0 (audit).
  couponCode         String?         @map("coupon_code")
  deliveryAddress    Json?           @map("delivery_address")
  deliveryAreaName   String?         @map("delivery_area_name")
  preferredShopId    String?         @map("preferred_shop_id")
  paymentStatus      PaymentStatus   @default(pending) @map("payment_status")
  riskScoreAtOrder   Int?            @map("risk_score_at_order")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  customer      Customer           @relation(fields: [customerId], references: [id])
  preferredShop Shop?              @relation("PreferredShop", fields: [preferredShopId], references: [id])
  fulfillments  OrderFulfillment[]
  items         OrderItem[]
  events        OrderEvent[]
  feedback      DriverFeedback[]

  @@index([customerId, createdAt])
  @@index([status])
  @@map("orders")
}

model OrderFulfillment {
  id                 String            @id @default(uuid())
  orderId            String            @map("order_id")
  shopId             String            @map("shop_id")
  driverId           String?           @map("driver_id")
  status             FulfillmentStatus @default(pending)
  deliveryDate       DateTime?         @map("delivery_date") @db.Date
  estimatedDeliveryAt DateTime?        @map("estimated_delivery_at")

  order    Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shop     Shop                @relation(fields: [shopId], references: [id])
  driver   Driver?             @relation(fields: [driverId], references: [id])
  items    OrderItem[]
  events   OrderEvent[]
  feedback DriverFeedback[]

  @@index([driverId, deliveryDate])
  @@index([shopId, status])
  @@index([deliveryDate])
  @@map("order_fulfillments")
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       String  @map("order_id")
  fulfillmentId String  @map("fulfillment_id")
  productId     String  @map("product_id")
  shopProductId String  @map("shop_product_id")
  quantity      Int
  unitPrice     Decimal @map("unit_price") @db.Decimal(10, 2)

  order       Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillment OrderFulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  shopProduct ShopProduct      @relation(fields: [shopProductId], references: [id])

  @@map("order_items")
}

model OrderEvent {
  id            String         @id @default(uuid())
  orderId       String         @map("order_id")
  fulfillmentId String?        @map("fulfillment_id")
  actorUserId   String?        @map("actor_user_id")
  eventType     OrderEventType @map("event_type")
  payload       Json           @default("{}")
  createdAt     DateTime       @default(now()) @map("created_at")

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fulfillment OrderFulfillment? @relation(fields: [fulfillmentId], references: [id])
  actor       User?             @relation("EventActor", fields: [actorUserId], references: [id])

  @@map("order_events")
}

model Driver {
  id       String  @id @default(uuid())
  userId   String  @unique @map("user_id")
  name     String
  phone    String?
  isActive Boolean @default(true) @map("is_active")

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fulfillments OrderFulfillment[]
  feedback     DriverFeedback[]

  @@map("drivers")
}

model DriverFeedback {
  id            String   @id @default(uuid())
  driverId      String   @map("driver_id")
  customerId    String   @map("customer_id")
  orderId       String   @map("order_id")
  fulfillmentId String?  @map("fulfillment_id")
  rating        Int
  tags          Json     @default("[]")
  suggestBlock  Boolean  @default(false) @map("suggest_block")
  createdAt     DateTime @default(now()) @map("created_at")

  driver      Driver             @relation(fields: [driverId], references: [id])
  customer    Customer           @relation(fields: [customerId], references: [id])
  order       Order              @relation(fields: [orderId], references: [id])
  fulfillment OrderFulfillment?  @relation(fields: [fulfillmentId], references: [id])

  @@map("driver_feedback")
}

model DeliveryCalendar {
  id          String  @id @default(uuid())
  areaName    String  @map("area_name")
  deliveryDay Weekday @map("delivery_day")
  isActive    Boolean @default(true) @map("is_active")

  @@unique([areaName, deliveryDay])
  @@index([areaName, isActive])
  @@map("delivery_calendar")
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  payload     Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Platform currencies. EUR is the seeded default and cannot be unpublished/deleted while default.
/// Shop/order amounts stay in the default currency; `exchangeRate` converts for display (units per 1 default).
model PlatformCurrency {
  id            String   @id @default(uuid())
  code          String   @unique
  symbol        String
  name          String
  /// Multiply default-currency amount by this to display in this currency. Default currency = 1.
  exchangeRate  Decimal  @default(1) @map("exchange_rate") @db.Decimal(18, 8)
  isDefault     Boolean  @default(false) @map("is_default")
  isPublished   Boolean  @default(false) @map("is_published")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("platform_currencies")
}

/// Platform languages. English is the seeded default and cannot be unpublished/deleted while default.
model PlatformLanguage {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  nativeName  String   @map("native_name")
  isRtl       Boolean  @default(false) @map("is_rtl")
  isDefault   Boolean  @default(false) @map("is_default")
  isPublished Boolean  @default(false) @map("is_published")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([isPublished, sortOrder])
  @@map("platform_languages")
}

/// Key/value platform config (e.g. hero_background_url).
model PlatformSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

/// Admin-curated homepage / sidebar “Popular categories” (taxonomy root ids).
/// Soft max 8 active; customer UI hides the section below 3.
model FeaturedCategory {
  id         String   @id @default(uuid())
  categoryId String   @unique @map("category_id")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("featured_categories")
}

/// Customer-facing legal policies (Privacy, Terms, Cookies, Refunds, …).
/// Body is Markdown; admin-editable; published docs appear on the storefront.
model LegalDocument {
  id           String    @id @default(uuid())
  slug         String    @unique
  title        String
  subtitle     String?
  bodyMarkdown String    @map("body_markdown") @db.Text
  sortOrder    Int       @default(0) @map("sort_order")
  isPublished  Boolean   @default(false) @map("is_published")
  showInFooter Boolean   @default(true) @map("show_in_footer")
  version      Int       @default(1)
  publishedAt  DateTime? @map("published_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([isPublished, showInFooter, sortOrder])
  @@map("legal_documents")
}

enum WhatsappThreadStatus {
  open
  closed
}

enum WhatsappMessageDirection {
  inbound
  outbound
}

/// WhatsApp care inbox thread (Phase B/C). One thread per phone.
model WhatsappThread {
  id              String               @id @default(uuid())
  phoneE164       String               @map("phone_e164")
  customerId      String?              @map("customer_id")
  status          WhatsappThreadStatus @default(open)
  /// Set when customer sends LIST / free-text shopping request; cleared when staff sends assist link or closes.
  needsAssistance Boolean              @default(false) @map("needs_assistance")
  /// Last Meta cart that could not be placed (unlinked phone / routing failure) for staff assist.
  pendingCommerceJson Json?            @map("pending_commerce_json")
  lastMessageAt   DateTime             @default(now()) @map("last_message_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  customer Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  messages WhatsappMessage[]

  @@unique([phoneE164])
  @@index([status, lastMessageAt])
  @@index([needsAssistance, lastMessageAt])
  @@index([customerId])
  @@map("whatsapp_threads")
}

model WhatsappMessage {
  id                String                    @id @default(uuid())
  threadId          String                    @map("thread_id")
  direction         WhatsappMessageDirection
  body              String                    @db.Text
  providerMessageId String?                   @map("provider_message_id")
  createdAt         DateTime                  @default(now()) @map("created_at")

  thread WhatsappThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("whatsapp_messages")
}
